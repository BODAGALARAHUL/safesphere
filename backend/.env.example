# SafeSphere API Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
MAX_REQUEST_SIZE=100kb

# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/safesphere?schema=public

# Authentication & JWT Configuration
JWT_ACCESS_SECRET=safesphere_dev_jwt_access_secret_key_32bytes_min!
JWT_REFRESH_SECRET=safesphere_dev_jwt_refresh_secret_key_32bytes_min!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
